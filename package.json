{
  "name": "mytube-seo",
  "version": "1.0.0",
  "description": "Extension Firefox de SEO et de gestion de chaîne YouTube (alternative à TubeBuddy).",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --overwrite-dest",
    "start": "web-ext run --source-dir extension --start-url https://www.youtube.com",
    "format": "prettier --write \"extension/**/*.{js,css,html,json}\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "web-ext": "^10.8.0"
  },
  "license": "MIT"
}
